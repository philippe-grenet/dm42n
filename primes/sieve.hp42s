;;; Segmented Sieve: https://en.wikipedia.org/wiki/Sieve_of_Eratosthenes
;;; Creates a matrix containing all prime numbers from 2 to a specified limit.
;;;
;;; Input: the limit n in X.
;;; Output: matrix of primes in X
;;;
;;; Registers:
;;; R00 = limit n
;;; R01 = a = index of current word in bit array A[]
;;; R02 = b = bit number if A[a]
;;; R03 = i
;;; R04 = j
;;; R05 = k or p
;;; R06 = temporary
;;; R07 = unused
;;; R08 = WSZ = word size in bits
;;; R09 = w = number of words in A[]
;;; R10..Rxx = A[] = bit array containing words.
;;;   Each word is a zero-indexed bit array storing flags for successive numbers from 2 to n.
;;;   The first word is for numbers 2..36, the second word for numbers 37..73, etc.
;;;   In each word, bits 0 mark the corresponding numbers as prime, bits 1 marks them as non-prime.
;;;   Note that by default we have R00..R14, which is 15 registers, or 15 * 35 = 525 numbers
;;;   (that's enough for the first 99 primes without segmentation).
;;;
;;; Notes:
;;; 1. This program uses bitmap operations. On DM42, the word size is configurable and queryable.
;;;    For a real HP 42s you should set it to 35 bits (see notes in program).
;;; 2. This program uses some Free42 extensions, see https://thomasokken.com/free42/#extensions.
;;;    It can however easily be made working without them. Extensions are marked in comments.
;;; 3. The limit at which the program switches from Sieve to Segmented Sieve in hard coded.

;;; *** LINKS ***
;;; https://cp-algorithms.com/algebra/sieve-of-eratosthenes.html

LBL "SIEVE"

FUNC 11                                 ; free42 extension
L4STK                                   ; free42 extension

STO 00                                  ; R00 = n

;;; --------------------------------------------------------------------------------
;;; Preconditions
;;; --------------------------------------------------------------------------------
FP
X!=0                                    ; limit must be integer
RTNERR 5                                ; free42 extension
RCL 00
2
X>=Y?                                   ; limit must be at last 2
RTNERR 5

;;; --------------------------------------------------------------------------------
;;; Word size
;;; --------------------------------------------------------------------------------
;;; Note: for a real HP 42s, store 35 in R08.
;;; HP 42s uses signed 36-bit words (see page 248 in the Owner's Manual).
WSIZE?                                  ; free42 extension
1, -
STO 08                                  ; WSZ

;;; --------------------------------------------------------------------------------
;;; Short-circuit to SIMPLE_SIEVE if limit is low enough to fit in registers
;;; --------------------------------------------------------------------------------
500
RCL 00
X>Y?
GTO B                                   ; SEGMENTED_SIEVE

XEQ A                                   ; SIMPLE_SIEVE
RCL "Base"
STO "Primes"
CLV "Base"
RCL "Primes"
RTN                                     ; END PROGRAM

;;; --------------------------------------------------------------------------------
;;; SEGMENTED_SIEVE
;;; --------------------------------------------------------------------------------
LBL B

;;; --------------------------------------------------------------------------------
;;; Divide the range 2 to n into s segments of size Δ ≥ √n
;;; --------------------------------------------------------------------------------
RCL 00
SQRT
ENTER                                   ; a little trick to round to the next integer
FP
+
IP
LSTO "S"                                ; free42 extension, segment_size

;;; --------------------------------------------------------------------------------
;;; Step 1: primes up to sqrt(n) -> matrix "Base"
;;; --------------------------------------------------------------------------------
RCL 00
STO 06                                  ; back up the limit n
RCL "S"
STO 00
XEQ A                                   ; SIMPLE_SIEVE
RCL 04                                  ; j = number of primes
LSTO "P"
RCL 06
STO 00                                  ; restore n

;;; --------------------------------------------------------------------------------
;;; Step 2: process segments [low, high)
;;; --------------------------------------------------------------------------------
2
LSTO "L"                                ; low = 2
RCL "S"
+
LSTO "H"                                ; high = low + segment_size

;;; while low <= n:
LBL 30

RCL 00                                  ; if high > n + 1 then high = n + 1
1
+
RCL "H"
XEQ H                                   ; MIN
LSTO "H"

;;; ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((
;;; Set up a bit array for the current segment
XEQ I                                   ; INIT_SEGMENT

;;; for all primes in matrix "Base":
RCL "P"
1000, /, IP, 1, +, STO 03               ; i = 1.ppp where ppp = number of primes

;;; (DEBUG
CLST
RCL "Base"
STOP
;;; DEBUG)

INDEX "Base"

LBL 31                                  ; loop on primes in "Base"
RCLEL
STO 05                                  ; p

;;; Find first multiple of p in [low, high):
;;; start = max(p * p, ((low + p - 1) // p) * p)
;;; for j in range(start, high, p):
;;;    A[j - low] = false
XEQ J                                   ; START
STO 04                                  ; j
LBL 32                                  ; for j loop
RCL 04                                  ; j
RCL "L"
-
XEQ c                                   ; SETBIT
RCL "H"
RCL 04                                  ; j
X>Y?
GTO 20
RCL 05                                  ; p
STO+ 04                                 ; j += p
GTO 32                                  ; for j loop
LBL 20

;;; Next prime p
RCL "P", 1, -
RCL 03, IP                              ; i
X>=Y?, GTO 21                           ; skip moving to next cell in the last iteration
RCLIJ, 1, +, STOIJ                      ; move to next cell
LBL 21
ISG 03
GTO 31                                  ; loop on primes in "Base"

;;; (DEBUG
CLST
RCL "L"  ; T
RCL "H"  ; Z
RCL 09   ; num words
RCL 10   ; A[0]
STOP
;;; DEBUG)

;;; TODO: Add primes from the segment A[] into the result matrix "Primes"
;;; ---- Create an empty matrix "Prime" in Step 1 (make it 1x1, set flag 01 to indicate it is empty)
;;; ---- Count the number of primes in A[], store result in j (same as SIMPLE_SIEVE)
;;; ---- Resize the matrix "Prime"
;;; ---- Store the primes in "Prime" (similar to "SIMPLE_SIEVE)
;;; ))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

;;; low = high
;;; high += segment_size
RCL "H"
LSTO "L"
RCL "S"
RCL "H"
+
LSTO "H"

RCL 00                                  ; n
RCL "L"
X<=Y?
GTO 30                                  ; while low <= n

RCL "Primes"
RTN                                     ; END PROGRAM


;;; ================================================================================
;;; Subroutine: SIMPLE_SIEVE
;;; Creates a matrix "Base" containing primes from 2 to limit n.
;;; ================================================================================
LBL A

;;; --------------------------------------------------------------------------------
;;; Calculate the number of words in A[], store in w
;;; --------------------------------------------------------------------------------
RCL 00                                  ; n
2, -                                    ; first number is 2
RCL 08, /, IP
STO 09                                  ; w = int(a / WSZ)

;;; --------------------------------------------------------------------------------
;;; Mark prime numbers in current segment in A[]
;;; --------------------------------------------------------------------------------
;; Initialize A[] with all words to 0 (initially all numbers are marked prime)
XEQ e                                   ; CLEAR_BITS

;;; for i = 2 to sqrt(n):
;;;   if A[i] is true:
;;;     for j = i2, i2+i, i2+2i, i2+3i, ..., not exceeding n:
;;;       set A[j] = false
RCL 00, SQRT, IP, 1000, /, 2 +, STO 03  ; i = 2.sss where sss= sqrt(n)

LBL 00                                  ; for loop on i

RCL 03                                  ; i
IP
XEQ b                                   ; GETBIT
FS? 00
GTO 01                                  ; A[i] = 1 = not true
;;; A[i] = 0 = true
RCL 03, IP, 2 *, STO 04                 ; j = i2

LBL 02                                  ; for loop on j
;;; set A[j] := false

RCL 04                                  ; j
XEQ c                                   ; SETBIT

RCL 03, IP, STO + 04                    ; j = j + i
RCL 00, RCL 04, X<=Y?, GTO 02           ; loop on j

LBL 01
ISG 03, GTO 00                          ; loop on i

;;; --------------------------------------------------------------------------------
;;; Count the number of primes in A[], store result in j
;;; --------------------------------------------------------------------------------
0, STO 04                               ; j = 0
RCL 00, 1000, /, 2, +, STO 03           ; i = 2.nnn where nnn = n

LBL 03                                  ; for loop on i

RCL 03, IP                              ; i
XEQ b                                   ; GETBIT
FS? 00
GTO 04                                  ; A[i] = 1 = not true
;;; A[i] = 0 = true
1, STO+ 04                              ; j++

LBL 04
ISG 03, GTO 03                          ; loop on i

;;; --------------------------------------------------------------------------------
;;; Store the primes into the result matrix "Base"
;;; --------------------------------------------------------------------------------
;;; Create a 1-row j-col matrix and index it
1
ENTER
RCL 04                                  ; j
NEWMAT
STO "Base"
INDEX "Base"

RCL 04, STO 05                          ; k = j
RCL 00, 1000, /, 2, +, STO 03           ; i = 2.nnn where nnn = n
LBL 05                                  ; for loop on i

RCL 03, IP                              ; i
XEQ b                                   ; GETBIT
FS? 00
GTO 06                                  ; A[i] = 1 = not true
;;; A[i] = 0 = true
RCL 03, IP, STOEL                       ; store i
1, STO - 05;                                 ; k--
RCL 05, X<=0?, GTO 06                   ; skip moving to next cell in the last iteration
RCLIJ, 1, +, STOIJ                      ; move to next cell

LBL 06
ISG 03, GTO 05                          ; loop on i
RTN                                     ; END SIMPLE_SIEVE


;;; ================================================================================
;;; Subroutine: CLEAR_BITS: set all words in A[] to zero
;;; Input: R09 = w = number of words
;;; Result in R10..Rxx (unlimited)
;;; ================================================================================
LBL e
0, STO 01                               ; a = 0
LBL 10
RCL 01, 10, +                           ; a + 10
0
STO IND ST Y
RCL 09                                  ; w
RCL 01                                  ; a
X>=Y?
RTN
1, STO + 01                             ; a++
GTO 10


;;; ================================================================================
;;; Subroutine: SETAB: set a and b to point to bit in A[x] according to WSZ
;;; Input: number x in X (x <= n)
;;; Side effects:
;;; - a = index in A[] (zero based)
;;; - b = bit number in A[] (zero based)
;;; ================================================================================
LBL a
2, -                                    ; ajust x: first number is 2
STO 02                                  ; store in b momentarily
RCL 08, /, IP
STO 01                                  ; a = word index in A[]
RCL 02
RCL 08, MOD
STO 02                                  ; b = bit number
RTN


;;; ================================================================================
;;; Subroutine: GETBIT A[x]
;;; Input: number x in X (x <= n)
;;; Results:
;;; - flag 00 set if bit = 1 (=> not true), clear if bit = 0 (=> true)
;;; ================================================================================
LBL b
CF 00
XEQ a                                   ; SETAB
RCL 01, 10, +                           ; a + 10
RCL IND ST X                            ; X = word number a in A[]
RCL 02                                  ; X = b
BIT?
SF 00
RTN


;;; ================================================================================
;;; Subroutine: SETBIT A[x]
;;; Input: number x in X (x <= n)
;;; ================================================================================
LBL c
XEQ a                                   ; SETAB
RCL 01, 10, +                           ; a + 10
RCL IND ST X                            ; X = word number a in A[]

2
RCL 02                                  ; b
Y^X                                     ; 2^b
OR

RCL 01, 10, +                           ; a + 10
X<>Y
STO IND ST Y                            ; set bit in A[]
RTN


;;; ================================================================================
;;; Subroutine: MAX
;;; Input: X, Y
;;; Output: X = max(X,Y)
;;; ================================================================================
LBL G
X<Y?
X<>Y
RTN

;;; ================================================================================
;;; Subroutine: MIN
;;; Input: X, Y
;;; Output: X = min(X,Y)
;;; ================================================================================
LBL H
X>Y?
X<>Y
RTN

;;; ================================================================================
;;; Subroutine: START
;;; start = max(p * p, ((low + p - 1) // p) * p)
;;; Output: X = start
;;; ================================================================================
LBL J
;;; ((low + p - 1) // p) * p
RCL "L"
RCL 05                                  ; p
+
1
-
RCL 05                                  ; p
/
IP                                      ; floor division (p is always positive)
RCL 05                                  ; p
*
;;; p * p
RCL 05                                  ; p
X^2
;;; max
XEQ G                                   ; MAX
RTN

;;; ================================================================================
;;; Subroutine: INIT_SEGMENT
;;; Initialize the bit array for the current segment
;;; ================================================================================
;; Calculate number of words w = int((high - low) / WSZ)
LBL I
RCL "H"
RCL "L"
-
RCL 08
/
IP
STO 09
;; Initialize A[] with all words to 0 (initially all numbers are marked prime)
XEQ e                                   ; CLEAR_BITS
RTN
