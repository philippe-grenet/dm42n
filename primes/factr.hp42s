;;; Factorize a number.
;;;
;;; Input: a number n on X.
;;;
;;; Output:
;;; - X: a matrix of the factors (not repeated)
;;; - Alpha: a message Prime or N factors
;;; - Flag 1: set if any factor is repeated
;;;
;;;; Algo:
;;; function distinct_prime_factors( n ):
;;;     if n <= 1:
;;;         return  // no prime factors
;;;
;;;     // Check factor 2
;;;     if n % 2 == 0:
;;;         output 2
;;;         while n % 2 == 0:
;;;             n = n / 2
;;;
;;;     // Check odd factors
;;;     f = 3
;;;     while f * f <= n:
;;;         if n % f == 0:
;;;             output f
;;;             while n % f == 0:
;;;                 n = n / f
;;;         f = f + 2
;;;
;;;     // If n is now > 1, it is prime
;;;     if n > 1:
;;;         output n
;;;
;;; Registers:
;;; - R00 = n
;;; - R01 = current factor (f)
;;; - R02 = number of factors
;;; - R01 .. R09 = factors (increasing)
;;;   Note: there is no limit in the number of registers being used.

LBL "FACTR"

FUNC 11                     ; Free42 extensions, see https://thomasokken.com/free42/#extensions
L4STK

STO 00

;; Preconditions
1
X>Y? , GTO E                ; Error

RCL 00, FP
X>0? , GTO E                ; Error

;; Initialize
2 STO 01                    ; current factor = 2
0 STO 02.                   ; number of factors = 0
CF 01
CLA

;;; --------------------------------------------------------------------------------
;;; Loop
;;; --------------------------------------------------------------------------------
LBL A
RCL 00, RCL 01, MOD
X=0? , GTO D
;; Not divisble
RCL 01, 2, X=Y?, GTO 03     ; if f = 2, set it to 3
RCL 01, 2 +, STO 01         ; else set it to f + 2
GTO C                       ; CHECKEND

;; INC3
LBL 03
3, STO 01                   ; set f to 3

;; CHECKEND
LCL C
RCL 00, SQRT
RCL 01
X>Y? , GTO B                ; if f > sqrt( n ) ENDCHECK
GTO A

;; DIV Divisible, store f as a factor
LBL D
1 , STO+ 02                 ; increment count of factors

RCL 02                      ; store the factor in R03 .. R09
2 , +                       ; y = register number (R03 at first)
RCL 01                      ; x = factor
STO IND ST Y

RCL 00, RCL 01, /, STO 00   ; n = n / f

;; Keep dividing n by f while possible
LBL 01
RCL 00, RCL 01, MOD, X!=0?, GTO A
SF 01                       ; at least one factor is present multiple times
RCL 00, RCL 01, /, STO 00   ; n = n / f
1, -, X=0?, GTO B           ; if f = 1, we are done
GTO 01

;; ENDCHECK
LBL B
;; when the loop ends, if the remaining of R00 is > 1, it is a factor too
1, RCL 00, X>Y?, GTO G    ; ADDLAST
GTO H                       ; SETRESULT

;; ADDLAST
LBL G
1, STO+ 02                  ; increment count

RCL 02                      ; store the factor in R03 .. R09
2 +                         ; y = register number (R03 at first)
RCL 00                      ; x = factor
STO IND ST Y

;; SETRESULT
LBL H
1, RCL 02, X>Y?, GTO 02     ; if count > 0, not prime
FS? 01, GTO 02              ; only one factor, but repeated, so not prime
GTO I                       ; the number is prime => PRIMECASE

LBL 02                      ; not prime
ARCL 02
1, RCL 02, X=Y?, GTO 04
|- " factors"
GTO 05

LBL 04
|- " factor"

LBL 05
XEQ MKMMAT
RCL Factors
AVIEW
RTN

;; PRIMECASE
LBL I
"Prime"
XEQ a                       ; equivalent of XEQ "NEWMAT"
RCL FACTORS
AVIEW
RTN

;; Errors
LBL E
"Error" AVIEW
RTN

;;; --------------------------------------------------------------------------------
;;; Subroutine: Create a 1-row, n-column matrix from a set of registers.
;;;
;;; Input:
;;; - R02 = number of factors
;;; - R03 .. R09 = factors (increasing)
;;;
;;; Output: matrix on X.
;;; --------------------------------------------------------------------------------

LBL a

;; Create a 1-row n-col matrix and index it
1
ENTER
RCL 02
NEWMAT
STO "Factors"
INDEX "Factors"

;; Use R01 as indirect addressing for R03..R09
3, STO 01

;; Loop on registers
LBL 10
RCL IND 01, STOEL
1, STO + 01
1, STO - 02
;; skip redimentioning. in the last iteration
RCL 02, X=0?, GTO 11
RCLIJ, 1 +, STOIJ

LBL 11
RCL 02, X>0?, GTO 10
RTN
